{
  "sharedComponents": [
    {
      "id": "X01",
      "package": "app/orchestration",
      "responsibility": "仅协调M02/M04/M07同UoW，无业务数据",
      "verification": "DV20"
    },
    {
      "id": "X02",
      "package": "app/shared/transactions.py",
      "responsibility": "UnitOfWork协议，Pg实现在infrastructure",
      "verification": "DV20"
    },
    {
      "id": "X03",
      "package": "app/bootstrap.py",
      "responsibility": "构造注入与有限任务注册",
      "verification": "DV20"
    },
    {
      "id": "X04",
      "package": "app/ops/readiness.py",
      "responsibility": "角色依赖就绪与capabilities",
      "verification": "DV21"
    },
    {
      "id": "X05",
      "package": "app/shared/contracts.py",
      "responsibility": "ER/RF/预算准入",
      "verification": "DV22",
      "counterPort": "AdmissionCounterPort",
      "adapter": "PgAdmissionCounter",
      "allowedDependencies": [
        "Clock",
        "configuration",
        "technical admission counter port"
      ],
      "forbiddenDependencies": [
        "business repositories",
        "record or claim state writes"
      ]
    }
  ],
  "handlers": [
    "MATCH_REBUILD",
    "MATCH_FANOUT",
    "EXPIRE",
    "PURGE",
    "NOTIFY"
  ],
  "readinessFields": [
    "role",
    "isLive",
    "businessReady",
    "runMode",
    "capabilities",
    "reasonCodes",
    "schemaVersion",
    "poolBudget",
    "lastProbeAt"
  ],
  "TDBaselineChoices": {
    "dirtySet": "disabled; per-event local check",
    "fanoutBatchSize": 20,
    "admissionStore": "PostgreSQL shared short transactions"
  }
}