[
  {
    "id": "M01",
    "package": "identity",
    "api": [
      "AuthController",
      "SessionController"
    ],
    "application": [
      "LoginService",
      "SessionService"
    ],
    "domain": [
      "SessionPolicy",
      "ObjectAccessPolicy"
    ],
    "ports": [
      "UserRepository",
      "SessionRepository",
      "IdentityPort",
      "ClockPort"
    ],
    "adapters": [
      "PgUserRepository",
      "PgSessionRepository",
      "DemoAuthAdapter",
      "SchoolIdentityAdapter"
    ],
    "boundary": "鉴权决策只返回ALLOW/错误码；不返回私密正文"
  },
  {
    "id": "M02",
    "package": "records",
    "api": [
      "RecordController",
      "MyRecordController"
    ],
    "application": [
      "PublishService",
      "EditService",
      "WithdrawService",
      "MyRecordQuery"
    ],
    "domain": [
      "FieldValidator",
      "RecordState",
      "RecordVisibility"
    ],
    "ports": [
      "EditWorkflowPort",
      "EditCommandPort",
      "RecordRepository",
      "MediaAttachPort",
      "EventPort",
      "PolicyPort"
    ],
    "adapters": [
      "PgRecordRepository",
      "RecordDtoMapper"
    ],
    "boundary": "维护记录主数据；跨申请失效通过事务协调器调用M04端口"
  },
  {
    "id": "M03",
    "package": "discovery",
    "api": [
      "SearchController",
      "CandidateController"
    ],
    "application": [
      "SearchService",
      "MatchProjector",
      "FanoutPlanner",
      "QualityModeService"
    ],
    "domain": [
      "MR1Scorer",
      "CandidateSelector",
      "MatchVersionPolicy"
    ],
    "ports": [
      "PublicRecordSnapshotPort",
      "MatchRepository",
      "RuleRepository",
      "TaskPort"
    ],
    "adapters": [
      "PgSearchAdapter",
      "PgMatchRepository",
      "RuleConfigAdapter"
    ],
    "boundary": "只接收公开快照；评分纯函数与持久投影分离"
  },
  {
    "id": "M04",
    "package": "claims",
    "api": [
      "ClaimController",
      "HandoverController"
    ],
    "application": [
      "ClaimService",
      "ReservationService",
      "HandoverService"
    ],
    "domain": [
      "ClaimState",
      "PairInvariant",
      "HandoverPolicy"
    ],
    "ports": [
      "PendingInvalidationPort",
      "ClaimRepository",
      "PairRecordPort",
      "ReservationRepository",
      "EventPort"
    ],
    "adapters": [
      "PgClaimRepository",
      "PgReservationRepository",
      "PairDtoMapper"
    ],
    "boundary": "两侧业务变化在同一UnitOfWork；不自行提交子事务"
  },
  {
    "id": "M05",
    "package": "governance",
    "api": [
      "ReportController",
      "AppealController",
      "CaseController"
    ],
    "application": [
      "CaseService",
      "AppealService",
      "AssignmentService"
    ],
    "domain": [
      "CaseState",
      "ReviewerConflictPolicy",
      "EvidenceDeadlinePolicy"
    ],
    "ports": [
      "CaseRepository",
      "AuthorizedEvidencePort",
      "RecordFlagPort",
      "AuditPort"
    ],
    "adapters": [
      "PgCaseRepository",
      "CaseDtoMapper"
    ],
    "boundary": "回避与分配是领域守卫；授权证据读取有审计"
  },
  {
    "id": "M06",
    "package": "lifecycle",
    "api": [
      "AccountController",
      "受限运维入口"
    ],
    "application": [
      "DeadlineReconciler",
      "PurgePlanner",
      "DeletionService",
      "RestoreGuard"
    ],
    "domain": [
      "RetentionPolicy",
      "PurgeGraph",
      "RestoreBarrierPolicy"
    ],
    "ports": [
      "SystemRecordPort",
      "SystemClaimPort",
      "DeletionManifestPort",
      "StoragePort"
    ],
    "adapters": [
      "PgPurgeRepository",
      "ManifestFileAdapter",
      "BackupRestoreAdapter"
    ],
    "boundary": "系统释放不受冻结阻挡；恢复先应用删除清单"
  },
  {
    "id": "M07",
    "package": "jobs_audit",
    "api": [
      "NotificationController",
      "JobAdminController",
      "AuditController"
    ],
    "application": [
      "OutboxRelay",
      "TaskRunner",
      "NotificationService",
      "AuditWriter"
    ],
    "domain": [
      "RetrySchedule",
      "LeaseFencePolicy",
      "NotificationTemplate"
    ],
    "ports": [
      "OutboxRepository",
      "JobRepository",
      "NotificationRepository",
      "AuditRepository"
    ],
    "adapters": [
      "PgOutboxRepository",
      "PgJobRepository",
      "ProcessSupervisor"
    ],
    "boundary": "处理器由启动层注册；核心模块不反向导入"
  },
  {
    "id": "M08",
    "package": "media",
    "api": [
      "MediaController"
    ],
    "application": [
      "UploadService",
      "AttachmentService",
      "MediaReadService"
    ],
    "domain": [
      "DecodeSanitizer",
      "MediaScopePolicy",
      "MediaGuard"
    ],
    "ports": [
      "StoragePort",
      "MediaRepository",
      "CurrentContentAccessPort"
    ],
    "adapters": [
      "PrivateFileStorageAdapter",
      "ImageDecoderAdapter",
      "PgMediaRepository"
    ],
    "boundary": "像素与scope校验后绑定；流式读仍需实时授权"
  },
  {
    "id": "M09",
    "package": "auxiliary",
    "api": [
      "FavoriteController",
      "StatisticsController"
    ],
    "application": [
      "FavoriteService",
      "AggregateProjection",
      "StatisticsQuery"
    ],
    "domain": [
      "FavoriteVisibilityPolicy",
      "MonthlyBucketPolicy"
    ],
    "ports": [
      "FavoriteRepository",
      "PublicVisibilityPort",
      "StatisticsRepository"
    ],
    "adapters": [
      "PgFavoriteRepository",
      "PgStatisticsRepository"
    ],
    "boundary": "收藏无快照；统计桶无对象ID和身份"
  }
]